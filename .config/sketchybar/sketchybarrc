#!/bin/bash

export CONFIG_DIR="$HOME/.config/sketchybar"
source "$CONFIG_DIR/colors.sh"

FONT="MesloLGS Nerd Font Mono"

# ── Bar ──────────────────────────────────────────────────────────────────────
sketchybar --bar \
  height=28         \
  blur_radius=0     \
  position=bottom   \
  sticky=on         \
  topmost=on        \
  padding_left=6    \
  padding_right=6   \
  color=$BAR_BG     \
  border_width=0    \
  font_smoothing=on \
  y_offset=0        \
  margin=0          \
  display=1

# ── Defaults ─────────────────────────────────────────────────────────────────
sketchybar --default \
  updates=when_shown                    \
  icon.font="$FONT:Regular:11.0"        \
  icon.color=$TEXT_COLOR                \
  label.font="$FONT:Regular:11.0"       \
  label.color=$TEXT_COLOR               \
  padding_left=2                        \
  padding_right=2                       \
  label.padding_left=2                  \
  label.padding_right=2                 \
  icon.padding_left=2                   \
  icon.padding_right=2                  \
  background.drawing=off

sketchybar --add event aerospace_workspace_change

# ── LEFT: Workspaces ─────────────────────────────────────────────────────────
for i in 1 2 3 4 5; do
  sketchybar --add item space.$i left \
    --set space.$i \
      icon="$i"                                    \
      icon.font="$FONT:Bold:11.0"                  \
      icon.color=$TEXT_COLOR                       \
      label.drawing=off                            \
      update_freq=1                                \
      script="$CONFIG_DIR/plugins/aerospace_workspace.sh" \
    --subscribe space.$i aerospace_workspace_change
done

sketchybar --add item sep_left left \
  --set sep_left \
    icon="|"                         \
    icon.color=$SEP_COLOR            \
    icon.font="$FONT:Regular:11.0"   \
    label.drawing=off                \
    padding_left=3                   \
    padding_right=3

# ── LEFT: Active window titles ────────────────────────────────────────────────
sketchybar --add item windows left \
  --set windows \
    icon.drawing=off                              \
    label.color=$TEXT_COLOR                       \
    label.font="$FONT:Regular:11.0"               \
    update_freq=3                                 \
    script="$CONFIG_DIR/plugins/windows.sh"       \
  --subscribe windows aerospace_workspace_change

# ── CENTER: Spotify ──────────────────────────────────────────────────────────
sketchybar --add item spotify center \
  --set spotify \
    update_freq=5                                            \
    updates=on                                               \
    icon.drawing=off                                         \
    label.color=$TEXT_COLOR                                  \
    label.font="$FONT:Regular:11.0"                          \
    script="$CONFIG_DIR/plugins/spotify.sh"

# ── RIGHT: Days left | sep | Volume ───────────────────────────────────────────
sketchybar --add item year_countdown right \
  --set year_countdown \
    update_freq=3600                          \
    icon.drawing=off                          \
    label.color=$TEXT_COLOR                   \
    label.font="$FONT:Regular:11.0"           \
    script="$CONFIG_DIR/plugins/year_countdown.sh"

sketchybar --add item sep_right right \
  --set sep_right \
    icon="|"                         \
    icon.color=$SEP_COLOR            \
    icon.font="$FONT:Regular:11.0"   \
    label.drawing=off                \
    padding_left=1                   \
    padding_right=1

sketchybar --add item volume right \
  --set volume \
    updates=on                                \
    icon.color=$TEXT_COLOR                    \
    label.drawing=off                         \
    update_freq=5                             \
    script="$CONFIG_DIR/plugins/volume.sh"    \
  --subscribe volume mouse.clicked

sketchybar --update
