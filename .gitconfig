[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
[user]
	name = Brenno A
	email = 177304304+Brennoaltair@users.noreply.github.com
[core]
	excludesfile = ~/.gitignore_global
[pull]
	rebase = true
[push]
	autoSetupRemote = true
[init]
	defaultBranch = main
